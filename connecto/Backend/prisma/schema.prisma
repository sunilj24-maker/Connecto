generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CreatorProfile {
  id                     String          @id @default(uuid())
  name                   String?
  profile_image_url      String?
  primary_location       String
  audience_top_locations String[]
  areas_of_interest      String[]
  social_profiles        SocialProfile[]

  audience_primary_age_min Int
  audience_primary_age_max Int
  audience_top_interests   String[]
  audience_gender_split    String?
}

enum SocialPlatform {
  TWITTER
  INSTAGRAM
  YOUTUBE
  TIKTOK
  SNAPCHAT
  TELEGRAM
  WHATSAPP
  TWITCH
  OTHER
}

model SocialProfile {
  id             String         @id @default(uuid())
  creator_id     String
  creator        CreatorProfile @relation(fields: [creator_id], references: [id], onDelete: Cascade)
  platform       SocialPlatform
  handle         String
  url            String
  follower_count Int
}

model Campaign {
  id                        String   @id @default(uuid())
  title                     String?
  target_audience_location  String?
  target_audience_age_min   Int
  target_audience_age_max   Int
  target_audience_interests String[]
}
